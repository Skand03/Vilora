# ==============================================================================
# VILORA NATURALS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This template documents all environment variables used by the Spring Boot backend.
#
# FOR RENDER DEPLOYMENT:
# Add these variables under your Web Service > "Environment" tab in Render Dashboard.
# NEVER commit real secret values to Git or public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Render automatically injects PORT=10000 at runtime.
# For local execution, defaults to 10000 (or 9999).
PORT=10000

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND INTEGRATION
# ------------------------------------------------------------------------------
# Set to your deployed Vercel frontend URL so the browser allows cross-origin API calls.
# Multiple origins can be comma-separated. Wildcards like https://*.vercel.app are pre-enabled.
# Example: https://vilora-naturals.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app
FRONTEND_URL=https://your-frontend-app.vercel.app

# ------------------------------------------------------------------------------
# 3. SUPABASE REST API & STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard > Project Settings > API
# Direct HTTPS REST API data access via PostgREST (No JDBC / JPA / Hibernate needed)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Key (Use service_role key for backend server for complete data access, or anon key)
# The backend communicates securely server-to-server and NEVER leaks this key to clients.
SUPABASE_KEY=your_supabase_service_role_or_anon_key_here

# Supabase Storage bucket for product images
SUPABASE_BUCKET_NAME=product-images

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Secure 256-bit+ HMAC SHA-512 hex or base64 key (minimum 64 characters)
# Generate with: openssl rand -hex 64
JWT_SECRET=your_secure_256_bit_jwt_secret_key_change_in_production_min_64_characters

# Token expiration time in milliseconds (e.g., 86400000 = 24 hours, 604800000 = 7 days)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 5. INITIAL ADMINISTRATOR BOOTSTRAP (OPTIONAL)
# ------------------------------------------------------------------------------
# Automatically provisions/elevates an administrator account in Supabase on startup.
ADMIN_BOOTSTRAP_EMAIL=admin@viloranaturals.com
ADMIN_BOOTSTRAP_PASSWORD=your_secure_admin_password_here
ADMIN_BOOTSTRAP_NAME=Vilora Administrator
