# ==============================================================================
# VILORA NATURALS - LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your actual credentials.
# Do NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Server Port (Runs on port 8081 locally)
PORT=8081

# ------------------------------------------------------------------------------
# SUPABASE REST API CONFIGURATION
# Direct HTTPS REST API data access via PostgREST (No JDBC / JPA / Hibernate)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_BUCKET_NAME=product-images

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# 256-bit+ HMAC SHA-512 hex or base64 key (min 64 characters)
JWT_SECRET=your_secure_256_bit_jwt_secret_key_change_in_production_min_64_characters
# Expiration in milliseconds (e.g., 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# INITIAL ADMINISTRATOR BOOTSTRAPPING (OPTIONAL)
# Automatically creates the admin user on first startup if not already existing
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@viloranaturals.com
ADMIN_BOOTSTRAP_PASSWORD=your_secure_admin_password_here
ADMIN_BOOTSTRAP_NAME=Vilora Administrator
