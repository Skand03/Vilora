              "raw": "{\n  \"fullName\": \"Kavita Sharma\",\n  \"email\": \"kavita.customer@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"address\": \"Flat 402, Sunshine Heights, Mumbai\"\n}"
